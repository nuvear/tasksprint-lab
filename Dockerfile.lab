# syntax=docker/dockerfile:1
# TaskSprint lab service (Architecture A2). One worker; SQLite on the /data volume.
# NOT BUILT on the owner VM (Docker is not installed there); verify on a Docker host.
# Before deployment (Phase 05), pin both base images by digest.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /usr/local/bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv TASKSPRINT_DB_PATH=/data/tasksprint.sqlite3 \
    TASKSPRINT_FIXTURES_DIR=/app/instructor/fixtures
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project && rm /usr/local/bin/uv
COPY services/__init__.py services/__init__.py
COPY services/lab/ services/lab/
COPY instructor/fixtures/ instructor/fixtures/
RUN useradd --system --uid 10002 --no-create-home --shell /usr/sbin/nologin lab \
    && mkdir -p /data && chown 10002:10002 /data
USER 10002
VOLUME ["/data"]
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD ["/opt/venv/bin/python", "-c", "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2).status == 200 else 1)"]
CMD ["/opt/venv/bin/uvicorn", "--factory", "services.lab.main:create_app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-server-header"]
