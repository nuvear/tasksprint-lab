# Template only. New TaskSprint services, not the existing Langflow environment.
# Generate actual values privately into ignored local configuration:
#   uv run python scripts/local_init.py   -> .local/role_tokens.env, .local/lab.env (0600)
# Then start the lab with TASKSPRINT_ENV_FILE=.local/lab.env.
TASKSPRINT_DB_PATH=/data/tasksprint.sqlite3
TASKSPRINT_DEMO_ENABLED=true
TASKSPRINT_API_BASE=
TASKSPRINT_RUNNER_URL=
# Designated synthetic workspaces the instructor may seed/reset (comma-separated).
TASKSPRINT_ALLOWED_WORKSPACES=demo-001
# Optional private env file read before the process environment (process env wins).
TASKSPRINT_ENV_FILE=
# SQLite rollback-journal mode. TRUNCATE avoids deleting journal files (needed on
# filesystems that forbid unlink, such as the owner's mounted folder). One worker only.
TASKSPRINT_SQLITE_JOURNAL_MODE=TRUNCATE
# Hard request-body limit in bytes (1 KiB..1 MiB).
TASKSPRINT_MAX_BODY_BYTES=65536
# Directory holding instructor fixtures (starter v0 is seeded from here).
TASKSPRINT_FIXTURES_DIR=
# Transport-only runner credential (lab -> runner); authorizes nothing else. Phase 03.
TS_RUNNER_TOKEN=
# SHA-256 hex digests of the role tokens. The lab stores hashes, never the tokens.
TS_COORD_TOKEN_HASH=
TS_PO_TOKEN_HASH=
TS_DEV_TOKEN_HASH=
TS_QA_TOKEN_HASH=
TS_OPS_TOKEN_HASH=
TS_APP_TOKEN_HASH=
TS_APPROVER_TOKEN_HASH=
TS_INSTRUCTOR_TOKEN_HASH=
TS_EVALUATOR_TOKEN_HASH=
# TS_A2A_API_KEY is a Langflow-issued API key (Phase 08); it is not generated here
# and never belongs in this file.
# Never add the existing admin password, LANGFLOW_SECRET_KEY or Langflow DB URL here.
