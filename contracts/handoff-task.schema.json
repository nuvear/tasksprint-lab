{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskSprint application release assessment task (not a Langflow flow export)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent",
    "workspace_id",
    "candidate_id",
    "candidate_sha256",
    "app_test_run_id",
    "agent_manifest_id",
    "deadline_utc",
    "allow_execute"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "intent": {
      "const": "assess_release"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "app_test_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "agent_manifest_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "deadline_utc": {
      "type": "string",
      "format": "date-time"
    },
    "allow_execute": {
      "const": false
    }
  }
}
